# Copy this template only for a fresh installation. Keep existing owner settings.
# Hosted answer and follow-up rewriting provider; all three fields are required.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Local HTTP authentication. Generate a new secret; never leave this empty.
API_KEY=
API_HOST=127.0.0.1
API_PORT=8000

# Local services. The provided launcher uses ports 6333, 8101, 8102, and 8103.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=course_rag
EMBEDDING_URL=http://127.0.0.1:8101/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RERANKER_URL=http://127.0.0.1:8102
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
VLM_URL=http://127.0.0.1:8103/v1
VLM_MODEL=Qwen/Qwen3.8-27B

# Request and indexing controls.
REQUEST_TIMEOUT=180
EMBEDDING_BATCH_SIZE=8

# Fixed dates and project-relative artifact locations.
SOURCE_DATE=2026-10-01
BUILD_DATE=2026-10-05
CHUNKS_PATH=data/processed/chunks.jsonl
MODEL_LOCK_PATH=config/models.lock.json

# Optional resident local speech worker (python scripts/services.py start speech).
# Ten seconds is the warm synthesis target; longer passages can take longer.
SPEECH_URL=http://127.0.0.1:8104
SPEECH_TIMEOUT=600
